# -----------------------------------------------------------------------
# Copy this file to .streamlit/secrets.toml for LOCAL runs (that file is
# gitignored and must never be committed).
#
# For a DEPLOYED app on Streamlit Community Cloud, do NOT upload this file.
# Instead paste its contents (with real values) into:
#   your app -> Settings -> Secrets
# -----------------------------------------------------------------------

[cookie]
name = "malaria_dashboard_cookie"
key = "REPLACE_WITH_A_LONG_RANDOM_STRING"   # e.g. output of: python -c "import secrets; print(secrets.token_hex(32))"
expiry_days = 7

[credentials.usernames.admin]
name = "Program Admin"
password = "ChangeMe123!"     # plain text here is fine -- the app hashes it in memory on startup

[credentials.usernames.analyst1]
name = "MOH Analyst"
password = "Malaria2024!"
